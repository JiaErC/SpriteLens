<Window x:Class="SpriteLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SpriteLens.Controls"
        Title="精灵镜 SpriteLens"
        Width="1320" Height="840" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource B.Bg}"
        Foreground="{DynamicResource B.Text}"
        FontFamily="{StaticResource Font.Sans}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/SpriteLens.png"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder" Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Line2}" BorderThickness="1">
        <Grid x:Name="RootGrid">
            <Grid x:Name="Shell">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- ==================== 顶栏 ==================== -->
                <Grid x:Name="TopBar" Grid.Row="0" Background="{DynamicResource B.Topbar}" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0">
                        <Image Source="pack://application:,,,/Assets/SpriteLens.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                            <TextBlock Text="精灵镜" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="BrandSub" Text="SpriteLens" FontSize="10" Foreground="{DynamicResource B.Text3}" Margin="7,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="OpenButton" Grid.Column="1" Style="{StaticResource Button.Primary}" Height="34" Margin="0,0,7,0"
                            Click="OpenButton_Click" ToolTip="打开图片、文件夹或剪贴板图片（Ctrl+O）"
                            AutomationProperties.Name="打开图片菜单">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Geometry="{StaticResource Ico.Image}" Width="16" Height="16" Foreground="{DynamicResource B.PrimaryText}" />
                            <TextBlock Text="打开" Margin="7,0,3,0" Foreground="{DynamicResource B.PrimaryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <controls:Icon Geometry="{StaticResource Ico.Chevron}" Width="13" Height="13" Foreground="{DynamicResource B.PrimaryText}" Opacity=".85" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="FileChip" Grid.Column="2" Style="{StaticResource Button.Ghost}" Height="40" MaxWidth="258"
                            HorizontalContentAlignment="Left" Click="FileChip_Click" ToolTip="查看文件信息（I）"
                            AutomationProperties.Name="文件信息">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Geometry="{StaticResource Ico.Image}" Width="17" Height="17" Foreground="{DynamicResource B.Text3}" Margin="0,0,9,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FileNameText" Text="未打开图片" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                <TextBlock x:Name="FileMetaText" Text="拖入图片或按 Ctrl + O" FontSize="10.5" Foreground="{DynamicResource B.Text3}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="210" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 帧尺寸控制 -->
                    <Border x:Name="FrameCtl" Grid.Column="4" Height="42" VerticalAlignment="Center" Margin="6,0,8,0"
                            Background="{DynamicResource B.Panel2}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1" CornerRadius="12" Padding="4,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="帧" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text3}" Margin="5,0,6,0" VerticalAlignment="Center" />
                            <Grid Width="64" Height="28" ToolTip="帧宽（图像像素），输入后立即显示分割线">
                                <TextBox x:Name="FrameWidthBox" Style="{StaticResource NumField}" Width="64" Height="28"
                                         AutomationProperties.Name="帧宽" TextChanged="FrameBox_TextChanged"
                                         PreviewTextInput="NumberBox_PreviewTextInput" DataObject.Pasting="NumberBox_Pasting"
                                         PreviewKeyDown="FrameBox_PreviewKeyDown" GotKeyboardFocus="FrameBox_GotKeyboardFocus" />
                                <TextBlock x:Name="FrameWidthHint" Text="宽" FontSize="10.5" Foreground="{DynamicResource B.Text3}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <TextBlock Text="×" FontSize="11" Foreground="{DynamicResource B.Text3}" Margin="5,0,5,0" VerticalAlignment="Center" />
                            <Grid Width="64" Height="28" ToolTip="帧高（图像像素），输入后立即显示分割线">
                                <TextBox x:Name="FrameHeightBox" Style="{StaticResource NumField}" Width="64" Height="28"
                                         AutomationProperties.Name="帧高" TextChanged="FrameBox_TextChanged"
                                         PreviewTextInput="NumberBox_PreviewTextInput" DataObject.Pasting="NumberBox_Pasting"
                                         PreviewKeyDown="FrameBox_PreviewKeyDown" GotKeyboardFocus="FrameBox_GotKeyboardFocus" />
                                <TextBlock x:Name="FrameHeightHint" Text="高" FontSize="10.5" Foreground="{DynamicResource B.Text3}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="PresetButton" Style="{StaticResource IconButton.Small}" Width="24" Height="24" Margin="2,0,1,0"
                                    Click="PresetButton_Click" ToolTip="推荐帧尺寸" AutomationProperties.Name="推荐帧尺寸">
                                <controls:Icon Geometry="{StaticResource Ico.Chevron}" Width="14" Height="14" />
                            </Button>
                            <Border x:Name="FrameBadge" Background="{DynamicResource B.Hover}" CornerRadius="6" Padding="7,3" Margin="4,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FrameBadgeText" Text="未设置" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text3}" />
                            </Border>
                            <Border Width="1" Height="20" Background="{DynamicResource B.Line}" Margin="5,0" />
                            <Button x:Name="GridStyleButton" Style="{StaticResource IconButton.Small}" Width="26" Height="26"
                                    Click="GridStyleButton_Click" ToolTip="网格样式与粗细" AutomationProperties.Name="网格样式">
                                <controls:Icon Geometry="{StaticResource Ico.Sliders}" Width="16" Height="16" />
                            </Button>
                            <ToggleButton x:Name="GridToggle" Style="{StaticResource Switch}" Margin="5,0,2,0" IsChecked="True"
                                          Checked="GridToggle_Changed" Unchecked="GridToggle_Changed"
                                          ToolTip="显示帧网格（G）" AutomationProperties.Name="显示帧网格" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="InfoButton" Style="{StaticResource IconButton}" Click="InfoButton_Click" ToolTip="信息面板（I）" AutomationProperties.Name="信息面板">
                            <controls:Icon Geometry="{StaticResource Ico.Panel}" Width="17" Height="17" />
                        </Button>
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Click="ThemeButton_Click" ToolTip="切换明暗主题（T）" AutomationProperties.Name="切换主题">
                            <controls:Icon x:Name="ThemeIcon" Geometry="{StaticResource Ico.Sun}" Width="17" Height="17" />
                        </Button>
                        <Button x:Name="HelpButton" Style="{StaticResource IconButton}" Click="HelpButton_Click" ToolTip="帮助与快捷键（?）" AutomationProperties.Name="帮助">
                            <controls:Icon Geometry="{StaticResource Ico.Help}" Width="17" Height="17" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Click="MinimizeButton_Click" AutomationProperties.Name="最小化">
                            <controls:Icon Geometry="{StaticResource Ico.WindowMin}" Width="11" Height="11" StrokeThickness="1.3" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="MaximizeButton_Click" AutomationProperties.Name="最大化">
                            <controls:Icon x:Name="MaxIcon" Geometry="{StaticResource Ico.WindowMax}" Width="11" Height="11" StrokeThickness="1.3" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" AutomationProperties.Name="关闭">
                            <controls:Icon Geometry="{StaticResource Ico.WindowClose}" Width="11" Height="11" StrokeThickness="1.3" />
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="0" Grid.ColumnSpan="7" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource B.Line}" IsHitTestVisible="False" />
                </Grid>

                <!-- ==================== 舞台 ==================== -->
                <Grid x:Name="Stage" Grid.Row="1" Background="{DynamicResource B.Stage}" ClipToBounds="True"
                      AllowDrop="True" DragEnter="Stage_DragEnter" DragOver="Stage_DragOver"
                      DragLeave="Stage_DragLeave" Drop="Stage_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="InfoColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Rectangle Fill="{DynamicResource B.StageGlow}" IsHitTestVisible="False" />

                    <controls:SpriteView x:Name="Sprite"
                                         ViewChanged="Sprite_ViewChanged"
                                         PointerChanged="Sprite_PointerChanged"
                                         FrameClicked="Sprite_FrameClicked"
                                         FrameActivated="Sprite_FrameActivated" />

                    <!-- 空状态 -->
                    <Grid x:Name="EmptyState">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                            <Grid Width="136" Height="136" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <Grid.Effect>
                                    <DropShadowEffect BlurRadius="42" ShadowDepth="14" Direction="270" Opacity="0.45" Color="#FF000000" RenderingBias="Performance" />
                                </Grid.Effect>
                                <Border Background="{DynamicResource B.CheckerSmall}" CornerRadius="14" Padding="3">
                                    <Grid Width="128" Height="128">
                                        <Image Source="pack://application:,,,/samples/slime_32x32.png" Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        <Canvas Width="128" Height="128" ClipToBounds="True" IsHitTestVisible="False">
                                            <Path Data="M64,0 L64,128 M0,64 L128,64" Stroke="#D9FFFFFF" StrokeThickness="3" />
                                            <Path Data="M64,0 L64,128 M0,64 L128,64" Stroke="#EB080A0E" StrokeThickness="1" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Text="把精灵图拖进来" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource B.TitleGradient}" />
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,18" FontSize="13" LineHeight="23"
                                       Foreground="{DynamicResource B.Text2}">
                                输入帧宽与帧高，立刻用清晰的线条看清每一帧。<LineBreak />
                                支持 PNG / WebP / JPG / GIF / BMP，也可以直接打开整个文件夹。
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource Button.Primary}" Height="40" Padding="18,0" Click="EmptyOpen_Click" AutomationProperties.Name="打开图片">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Geometry="{StaticResource Ico.Image}" Width="17" Height="17" Foreground="{DynamicResource B.PrimaryText}" />
                                        <TextBlock Text="打开图片" Margin="7,0,0,0" Foreground="{DynamicResource B.PrimaryText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Base}" Height="40" Margin="9,0,0,0" Padding="16,0" Click="EmptyFolder_Click" AutomationProperties.Name="打开文件夹">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Geometry="{StaticResource Ico.Folder}" Width="17" Height="17" />
                                        <TextBlock Text="打开文件夹" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}" Height="40" Margin="4,0,0,0" Padding="13,0" Click="EmptySamples_Click" AutomationProperties.Name="载入示例">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Geometry="{StaticResource Ico.Sparkles}" Width="17" Height="17" Foreground="{DynamicResource B.Accent}" />
                                        <TextBlock Text="载入示例" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border HorizontalAlignment="Center" Margin="0,20,0,0" Padding="14,6" CornerRadius="99"
                                    Background="{DynamicResource B.ButtonBg}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
                                <TextBlock Text="双色分割线 · 帧编号 · 动画预览 · 像素取色 · 拖拽 / 粘贴"
                                           FontSize="10.5" Foreground="{DynamicResource B.Text3}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 加载提示 -->
                    <Border x:Name="LoadingPill" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                            Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                            CornerRadius="99" Padding="12,7" Effect="{StaticResource E.Card}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                <Ellipse Stroke="{DynamicResource B.Line2}" StrokeThickness="2" />
                                <Ellipse Stroke="{DynamicResource B.Accent}" StrokeThickness="2" StrokeDashArray="2.5 6" StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <Trigger Property="IsVisible" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="正在解码…" FontSize="11.5" Foreground="{DynamicResource B.Text2}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 浮动工具栏 -->
                    <Border x:Name="FloatBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                            Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                            CornerRadius="14" Padding="6" Effect="{StaticResource E.Card}"
                            ToolTipService.InitialShowDelay="380" ToolTipService.ShowDuration="8000">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Click="ZoomOut_Click" ToolTip="缩小（−）" AutomationProperties.Name="缩小">
                                <controls:Icon Geometry="{StaticResource Ico.ZoomOut}" />
                            </Button>
                            <Button x:Name="ZoomText" Style="{StaticResource TextButton}" MinWidth="54" Click="ZoomText_Click" ToolTip="缩放比例" AutomationProperties.Name="缩放比例">100%</Button>
                            <Button Style="{StaticResource IconButton}" Click="ZoomIn_Click" ToolTip="放大（+）" AutomationProperties.Name="放大">
                                <controls:Icon Geometry="{StaticResource Ico.ZoomIn}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="Fit_Click" ToolTip="适应窗口（0）" AutomationProperties.Name="适应窗口">
                                <controls:Icon Geometry="{StaticResource Ico.Fit}" />
                            </Button>
                            <Button Style="{StaticResource TextButton}" Click="ActualSize_Click" ToolTip="实际像素 1:1（1）" AutomationProperties.Name="实际像素">1:1</Button>

                            <Border Width="1" Height="22" Background="{DynamicResource B.Line}" Margin="5,0" />

                            <Button Style="{StaticResource IconButton}" Click="RotateCcw_Click" ToolTip="向左旋转（Shift+R）" AutomationProperties.Name="向左旋转">
                                <controls:Icon Geometry="{StaticResource Ico.RotateCcw}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="RotateCw_Click" ToolTip="向右旋转（R）" AutomationProperties.Name="向右旋转">
                                <controls:Icon Geometry="{StaticResource Ico.RotateCw}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="FlipH_Click" ToolTip="水平翻转（H）" AutomationProperties.Name="水平翻转">
                                <controls:Icon Geometry="{StaticResource Ico.FlipH}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="FlipV_Click" ToolTip="垂直翻转（V）" AutomationProperties.Name="垂直翻转">
                                <controls:Icon Geometry="{StaticResource Ico.FlipV}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="Crop_Click" ToolTip="裁剪（C）" AutomationProperties.Name="裁剪">
                                <controls:Icon Geometry="{StaticResource Ico.Crop}" />
                            </Button>
                            <Button x:Name="AdjustButton" Style="{StaticResource IconButton}" Click="Adjust_Click" ToolTip="调整颜色（A）" AutomationProperties.Name="调整颜色">
                                <controls:Icon Geometry="{StaticResource Ico.Sliders}" />
                            </Button>
                            <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="Undo_Click" ToolTip="撤销上一步编辑（Ctrl+Z）" AutomationProperties.Name="撤销">
                                <controls:Icon Geometry="{StaticResource Ico.Undo}" />
                            </Button>

                            <Border Width="1" Height="22" Background="{DynamicResource B.Line}" Margin="5,0" />

                            <Button Style="{StaticResource IconButton}" Click="Preview_Click" ToolTip="帧预览（P）" AutomationProperties.Name="帧预览">
                                <controls:Icon Geometry="{StaticResource Ico.Film}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="Slideshow_Click" ToolTip="幻灯片（S）" AutomationProperties.Name="幻灯片">
                                <controls:Icon Geometry="{StaticResource Ico.Play}" Filled="True" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="Export_Click" ToolTip="导出（Ctrl+S）" AutomationProperties.Name="导出">
                                <controls:Icon Geometry="{StaticResource Ico.Download}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="Print_Click" ToolTip="打印（Ctrl+P）" AutomationProperties.Name="打印">
                                <controls:Icon Geometry="{StaticResource Ico.Printer}" />
                            </Button>
                            <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Click="Fullscreen_Click" ToolTip="全屏（F）" AutomationProperties.Name="全屏">
                                <controls:Icon x:Name="FullscreenIcon" Geometry="{StaticResource Ico.Expand}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Tag="danger" Click="Delete_Click" ToolTip="删除 / 移除（Delete）" AutomationProperties.Name="删除">
                                <controls:Icon Geometry="{StaticResource Ico.Trash}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 裁剪操作栏 -->
                    <Border x:Name="CropBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                            Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                            CornerRadius="14" Padding="6" Effect="{StaticResource E.Card}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0">
                                <controls:Icon Geometry="{StaticResource Ico.Crop}" Width="16" Height="16" Foreground="{DynamicResource B.Accent}" />
                                <TextBlock Text="裁剪" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Width="1" Height="22" Background="{DynamicResource B.Line}" Margin="4,0" />
                            <Border Background="{DynamicResource B.InputBg}" CornerRadius="8" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CropFreeRadio" GroupName="CropRatio" Style="{StaticResource ChipRadio}" Content="自由" Tag="free" IsChecked="True" Checked="CropRatio_Checked" />
                                    <RadioButton GroupName="CropRatio" Style="{StaticResource ChipRadio}" Content="1:1" Tag="1:1" Checked="CropRatio_Checked" />
                                    <RadioButton GroupName="CropRatio" Style="{StaticResource ChipRadio}" Content="帧比例" Tag="frame" Checked="CropRatio_Checked" />
                                    <RadioButton GroupName="CropRatio" Style="{StaticResource ChipRadio}" Content="4:3" Tag="4:3" Checked="CropRatio_Checked" />
                                    <RadioButton GroupName="CropRatio" Style="{StaticResource ChipRadio}" Content="16:9" Tag="16:9" Checked="CropRatio_Checked" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="拖动调整 · Enter 应用 · Esc 取消" FontSize="10.5" Foreground="{DynamicResource B.Text3}" Margin="12,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Small}" Content="取消" Click="CropCancel_Click" Margin="2,0" AutomationProperties.Name="取消裁剪" />
                            <Button Style="{StaticResource Button.Primary}" Height="28" Padding="14,0" FontSize="11.5" Content="应用" Click="CropApply_Click" Margin="5,0,2,0" AutomationProperties.Name="应用裁剪" />
                        </StackPanel>
                    </Border>

                    <!-- 颜色调整 -->
                    <Border x:Name="AdjustCard" Visibility="Collapsed" Width="334" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76"
                            Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1" CornerRadius="14"
                            Padding="14,12,14,10" Effect="{StaticResource E.Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="调整颜色" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IconButton.XS}" Click="AdjustReset_Click" ToolTip="重置调整" AutomationProperties.Name="重置调整">
                                        <controls:Icon Geometry="{StaticResource Ico.Undo}" Width="15" Height="15" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton.XS}" Click="AdjustClose_Click" ToolTip="关闭" AutomationProperties.Name="关闭调整">
                                        <controls:Icon Geometry="{StaticResource Ico.X}" Width="15" Height="15" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="亮度" Style="{StaticResource KVLabel}" />
                                <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="-100" Maximum="100" Value="0" ValueChanged="Adjustment_Changed" AutomationProperties.Name="亮度" />
                                <TextBlock x:Name="BrightnessValue" Grid.Column="2" Text="0" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="对比度" Style="{StaticResource KVLabel}" />
                                <Slider x:Name="ContrastSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="-100" Maximum="100" Value="0" ValueChanged="Adjustment_Changed" AutomationProperties.Name="对比度" />
                                <TextBlock x:Name="ContrastValue" Grid.Column="2" Text="0" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="饱和度" Style="{StaticResource KVLabel}" />
                                <Slider x:Name="SaturationSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="-100" Maximum="100" Value="0" ValueChanged="Adjustment_Changed" AutomationProperties.Name="饱和度" />
                                <TextBlock x:Name="SaturationValue" Grid.Column="2" Text="0" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="仅影响预览、打印与导出，不修改原文件" FontSize="10.5" Foreground="{DynamicResource B.Text3}" Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 帧预览 -->
                    <Border x:Name="PreviewCard" Visibility="Collapsed" Width="214" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,76"
                            Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1" CornerRadius="14"
                            Padding="10" Effect="{StaticResource E.Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Geometry="{StaticResource Ico.Film}" Width="15" Height="15" Foreground="{DynamicResource B.Accent}" />
                                    <TextBlock Text="帧预览" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton.XS}" HorizontalAlignment="Right" Click="PreviewClose_Click" AutomationProperties.Name="关闭帧预览">
                                    <controls:Icon Geometry="{StaticResource Ico.X}" Width="14" Height="14" />
                                </Button>
                            </Grid>
                            <Border Height="174" CornerRadius="9" BorderBrush="{DynamicResource B.Line}" BorderThickness="1" ClipToBounds="True" Background="{DynamicResource B.CheckerSmall}">
                                <controls:FramePreview x:Name="PreviewCanvas" Height="172" />
                            </Border>
                            <TextBlock x:Name="PreviewFrameLabel" Text="—" FontSize="10" FontFamily="{StaticResource Font.Mono}"
                                       Foreground="{DynamicResource B.Text2}" Margin="2,8,2,5" TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <RadioButton GroupName="PreviewScope" Style="{StaticResource SegmentRadio}" Content="当前行" Tag="row" IsChecked="True" Checked="PreviewScope_Changed" />
                                    <RadioButton GroupName="PreviewScope" Style="{StaticResource SegmentRadio}" Content="全部帧" Tag="all" Checked="PreviewScope_Changed" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="PreviewFpsBox" Style="{StaticResource NumField}" Width="34" Height="22" FontSize="10" Padding="2,0" Text="10" Margin="0,0,2,0"
                                             TextChanged="PreviewFps_Changed" PreviewTextInput="NumberBox_PreviewTextInput" DataObject.Pasting="NumberBox_Pasting"
                                             AutomationProperties.Name="预览帧率" />
                                    <TextBlock Text="fps" FontSize="9.5" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="PreviewPlayButton" Style="{StaticResource Button.Primary}" Height="30" Click="PreviewPlay_Click" AutomationProperties.Name="播放帧预览">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon x:Name="PreviewPlayIcon" Geometry="{StaticResource Ico.Play}" Width="14" Height="14" Filled="True" Foreground="{DynamicResource B.PrimaryText}" />
                                    <TextBlock x:Name="PreviewPlayText" Text="播放" Margin="6,0,0,0" Foreground="{DynamicResource B.PrimaryText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 拖放遮罩 -->
                    <Grid x:Name="DropOverlay" Visibility="Collapsed" Background="#B0040710" IsHitTestVisible="False">
                        <Border Margin="26" BorderBrush="{DynamicResource B.AccentLine}" BorderThickness="2" CornerRadius="22" Background="#148B97FF">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:Icon Geometry="{StaticResource Ico.Image}" Width="46" Height="46" Foreground="{DynamicResource B.Accent}" />
                                <TextBlock Text="松开即可打开" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center" />
                                <TextBlock Text="支持多张图片或整个文件夹" FontSize="12.5" Foreground="{DynamicResource B.Text2}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 信息面板 -->
                    <Border x:Name="InfoDrawer" Grid.Column="1" Width="344" Visibility="Collapsed" Opacity="0"
                            Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="16,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Geometry="{StaticResource Ico.Info}" Width="16" Height="16" Foreground="{DynamicResource B.Accent}" />
                                    <TextBlock Text="信息" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton.XS}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseInfo_Click" AutomationProperties.Name="关闭信息面板">
                                    <controls:Icon Geometry="{StaticResource Ico.X}" Width="14" Height="14" />
                                </Button>
                            </Grid>
                            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource B.Line}" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="InfoContent" Margin="16,0,16,22" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== 胶片条 ==================== -->
                <Border x:Name="FilmstripHost" Grid.Row="2" Height="92" Visibility="Collapsed"
                        Background="{DynamicResource B.Bg2}" BorderBrush="{DynamicResource B.Line}" BorderThickness="0,1,0,0">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="FilmList" Grid.Column="0" Style="{StaticResource FilmList}"
                                 SelectionMode="Single" SelectedIndex="-1" SelectionChanged="FilmList_SelectionChanged"
                                 AutomationProperties.Name="图片列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="66" Height="66">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Width="62" Height="62"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border Background="#B8000000" CornerRadius="3" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2">
                                            <TextBlock Text="{Binding Number}" FontSize="8.5" Foreground="#FFF2F5FA" FontFamily="{StaticResource Font.Mono}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="FilmCount" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,4,0"
                                   FontSize="10.5" Foreground="{DynamicResource B.Text3}" FontFamily="{StaticResource Font.Mono}" />
                    </Grid>
                </Border>

                <!-- ==================== 状态栏 ==================== -->
                <Border x:Name="StatusBarHost" Grid.Row="3" Background="{DynamicResource B.Bg2}" BorderBrush="{DynamicResource B.Line}" BorderThickness="0,1,0,0">
                    <Grid Margin="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusDims" Text="未打开图片" FontSize="11" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource B.Line2}" Margin="9,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusZoom" Text="—" FontSize="11" Foreground="{DynamicResource B.Text3}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource B.Line2}" Margin="9,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusCursor" Text="—" FontSize="11" Foreground="{DynamicResource B.Text3}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                            <StackPanel x:Name="StatusColor" Orientation="Horizontal" Visibility="Collapsed" Margin="9,0,0,0" VerticalAlignment="Center">
                                <Border x:Name="StatusColorSwatch" Width="11" Height="11" CornerRadius="3" BorderBrush="{DynamicResource B.Line2}" BorderThickness="1" />
                                <TextBlock x:Name="StatusColorText" Text="#000000" Margin="5,0,0,0" FontSize="11" Foreground="{DynamicResource B.Text2}"
                                           FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="StatusFrame" Text="" Visibility="Collapsed" Margin="12,0,0,0" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusGrid" Text="" FontSize="11" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusHint" Text="滚轮缩放 · 拖拽平移 · 双击定位帧" FontSize="11" Foreground="{DynamicResource B.Text3}"
                                       Opacity=".75" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 幻灯片 ==================== -->
            <Grid x:Name="SlideshowLayer" Visibility="Collapsed" Background="#FF04060A" MouseMove="Slideshow_MouseMove">
                <Image x:Name="SlideImageA" Stretch="Uniform" Opacity="1" RenderOptions.BitmapScalingMode="HighQuality" />
                <Image x:Name="SlideImageB" Stretch="Uniform" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="SlideLoading" Text="正在加载…" FontSize="12" Foreground="#88FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <Border x:Name="SlideControls" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                        Background="#D90E121A" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="13" Padding="6"
                        Effect="{StaticResource E.Card}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SlideIconButton}" Click="SlidePrev_Click" AutomationProperties.Name="幻灯片上一张">
                            <controls:Icon Geometry="{StaticResource Ico.ArrowLeft}" />
                        </Button>
                        <Button x:Name="SlidePlayButton" Style="{StaticResource SlideIconButton}" Click="SlidePlay_Click" AutomationProperties.Name="幻灯片暂停">
                            <controls:Icon x:Name="SlidePlayIcon" Geometry="{StaticResource Ico.Pause}" Filled="True" />
                        </Button>
                        <Button Style="{StaticResource SlideIconButton}" Click="SlideNext_Click" AutomationProperties.Name="幻灯片下一张">
                            <controls:Icon Geometry="{StaticResource Ico.ArrowRight}" />
                        </Button>
                        <TextBlock x:Name="SlideCounter" Text="1 / 1" FontSize="11" FontFamily="{StaticResource Font.Mono}"
                                   Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="8,0" />
                        <Button x:Name="SlideIntervalButton" Style="{StaticResource SlideIconButton}" Width="62" Click="SlideInterval_Click"
                                AutomationProperties.Name="幻灯片间隔">
                            <TextBlock x:Name="SlideIntervalText" Text="5 秒" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource SlideIconButton}" Click="SlideExit_Click" AutomationProperties.Name="退出幻灯片">
                            <controls:Icon Geometry="{StaticResource Ico.X}" />
                        </Button>
                    </StackPanel>
                </Border>
                <TextBlock Text="Esc 退出 · ← → 切换 · 空格 暂停" FontSize="10.5" Foreground="#66FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,78" />
            </Grid>

            <!-- ==================== 模态层 ==================== -->
            <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="{DynamicResource B.Scrim}"
                  MouseLeftButtonDown="ModalLayer_MouseLeftButtonDown">
                <!-- 帮助 -->
                <Border x:Name="HelpCard" Style="{StaticResource DialogCard}" Width="700" MaxHeight="620"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="60" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="20,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/SpriteLens.png" Width="24" Height="24" />
                                <TextBlock Text="精灵镜 SpriteLens" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton.XS}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="CloseHelp_Click" AutomationProperties.Name="关闭帮助">
                                <controls:Icon Geometry="{StaticResource Ico.X}" Width="15" Height="15" />
                            </Button>
                        </Grid>
                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource B.Line}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="22,2,22,12">
                                <TextBlock Text="快速开始" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="22" Foreground="{DynamicResource B.Text2}">
                                    打开或拖入精灵图，在顶部输入帧宽与帧高（单位：图像像素），画面上会立即出现分割线。
                                    例如一张 64×64、包含 2×2 帧的精灵图，输入 32×32 即可把四帧分开。
                                    分割线由深浅两层描边组成，无论精灵图是什么颜色都能看清。
                                </TextBlock>

                                <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + O" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="打开图片" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Ctrl + Shift + O" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="打开文件夹" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + V" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="粘贴剪贴板图片" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="← →" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="上一张 / 下一张" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="[  ]" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="上一帧 / 下一帧" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="+  −" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="缩放" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="0" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="适应窗口" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="1" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="实际像素 100%" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="G" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="显示 / 隐藏网格" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="L" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="显示 / 隐藏帧编号" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="C" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="裁剪" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="A" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="5" Grid.Column="3" Text="调整颜色" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="P" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="帧预览" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="S" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="6" Grid.Column="3" Text="幻灯片" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="F" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="全屏" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                    <TextBlock Grid.Row="7" Grid.Column="2" Text="I" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="7" Grid.Column="3" Text="信息面板" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="T" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="切换明暗主题" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                    <TextBlock Grid.Row="8" Grid.Column="2" Text="R / Shift+R" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="8" Grid.Column="3" Text="向右 / 向左旋转" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Delete" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="删除文件" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                    <TextBlock Grid.Row="9" Grid.Column="2" Text="Esc" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" Margin="0,4" />
                                    <TextBlock Grid.Row="9" Grid.Column="3" Text="关闭 / 取消" FontSize="11.5" Foreground="{DynamicResource B.Text2}" Margin="0,4" />
                                </Grid>

                                <TextBlock Text="图像编辑" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="22" Foreground="{DynamicResource B.Text2}">
                                    旋转、翻转与裁剪作用于当前查看副本，可随时用「还原所有编辑」回到原图；
                                    颜色调整只影响预览、打印和导出。所有处理都在本机完成，图片不会上传。
                                    删除文件会移入回收站。
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource B.Line}" BorderThickness="0,1,0,0">
                            <Grid Margin="20,0">
                                <TextBlock Text="本地运行 · 无需联网 · v1.0" FontSize="10.5" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Button.Primary}" Content="开始使用" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseHelp_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 确认 -->
                <Border x:Name="ConfirmCard" Style="{StaticResource DialogCard}" Width="440" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="ConfirmTitleText" Text="确认" FontSize="15" FontWeight="SemiBold" Margin="22,20,22,6" />
                        <TextBlock x:Name="ConfirmBodyText" Text="" TextWrapping="Wrap" FontSize="12.5" LineHeight="21"
                                   Foreground="{DynamicResource B.Text2}" Margin="22,0,22,20" />
                        <Border BorderBrush="{DynamicResource B.Line}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12">
                                <Button Style="{StaticResource Button.Base}" Content="取消" Click="ConfirmCancel_Click" Margin="0,0,8,0" AutomationProperties.Name="取消" />
                                <Button x:Name="ConfirmOkButton" Style="{StaticResource Button.Primary}" Content="确定" Click="ConfirmOk_Click" AutomationProperties.Name="确定" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 输入 -->
                <Border x:Name="InputCard" Style="{StaticResource DialogCard}" Width="440" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="InputTitleText" Text="重命名" FontSize="15" FontWeight="SemiBold" Margin="22,20,22,6" />
                        <TextBlock x:Name="InputHintText" Text="输入新的文件名" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="22,0,22,10" />
                        <TextBox x:Name="InputBox" Style="{StaticResource TextInput}" Height="36" Margin="22,0,22,20" AutomationProperties.Name="文件名输入框" KeyDown="InputBox_KeyDown" />
                        <Border BorderBrush="{DynamicResource B.Line}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12">
                                <Button Style="{StaticResource Button.Base}" Content="取消" Click="InputCancel_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Button.Primary}" Content="确定" Click="InputOk_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="ToastStack" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,86" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>





