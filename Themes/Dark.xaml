<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 色板 ============ -->
    <Color x:Key="C.Bg">#FF0A0C11</Color>
    <Color x:Key="C.Bg2">#FF0D1017</Color>
    <Color x:Key="C.Topbar">#F20D1017</Color>
    <Color x:Key="C.Panel">#FF151922</Color>
    <Color x:Key="C.Panel2">#FF1B2130</Color>
    <Color x:Key="C.Panel3">#FF222937</Color>
    <Color x:Key="C.Line">#14FFFFFF</Color>
    <Color x:Key="C.Line2">#26FFFFFF</Color>
    <Color x:Key="C.Text">#FFE9EDF5</Color>
    <Color x:Key="C.Text2">#FFA0A9BA</Color>
    <Color x:Key="C.Text3">#FF6C7587</Color>
    <Color x:Key="C.Accent">#FF8B97FF</Color>
    <Color x:Key="C.Accent2">#FF46E2CB</Color>
    <Color x:Key="C.AccentSoft">#248B97FF</Color>
    <Color x:Key="C.AccentLine">#618B97FF</Color>
    <Color x:Key="C.Danger">#FFFF7080</Color>
    <Color x:Key="C.DangerSoft">#21FF7080</Color>
    <Color x:Key="C.Warn">#FFFFC061</Color>
    <Color x:Key="C.WarnSoft">#21FFC061</Color>
    <Color x:Key="C.Hover">#12FFFFFF</Color>
    <Color x:Key="C.Pressed">#08FFFFFF</Color>
    <Color x:Key="C.ButtonBg">#0BFFFFFF</Color>
    <Color x:Key="C.ButtonHover">#14FFFFFF</Color>
    <Color x:Key="C.ButtonPressed">#06FFFFFF</Color>
    <Color x:Key="C.Select">#FF2B3350</Color>
    <Color x:Key="C.Scrim">#A6040710</Color>
    <Color x:Key="C.CheckerA">#FF1A1F29</Color>
    <Color x:Key="C.CheckerB">#FF232936</Color>
    <Color x:Key="C.SliderTrack">#2EFFFFFF</Color>
    <Color x:Key="C.InputBg">#38000000</Color>
    <Color x:Key="C.CropShade">#A6060910</Color>
    <Color x:Key="C.ImageBorder">#26FFFFFF</Color>

    <!-- 网格层：与图片内容无关，保证任何图片上都清晰 -->
    <Color x:Key="C.GridHalo">#D9FFFFFF</Color>
    <Color x:Key="C.GridCore">#EB080A0E</Color>
    <Color x:Key="C.GridAccent">#FF46E2CB</Color>
    <Color x:Key="C.LabelBg">#B80A0E15</Color>
    <Color x:Key="C.LabelBorder">#2EFFFFFF</Color>
    <Color x:Key="C.LabelText">#FFF2F5FA</Color>
    <Color x:Key="C.FrameHoverFill">#0F8B97FF</Color>
    <Color x:Key="C.FrameHoverLine">#FF8B97FF</Color>
    <Color x:Key="C.FrameSelFill">#148B97FF</Color>
    <Color x:Key="C.FrameSelLine">#FF8B97FF</Color>

    <!-- ============ 画笔 ============ -->
    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="B.Bg2" Color="{StaticResource C.Bg2}" />
    <SolidColorBrush x:Key="B.Topbar" Color="{StaticResource C.Topbar}" />
    <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Panel}" />
    <SolidColorBrush x:Key="B.Panel2" Color="{StaticResource C.Panel2}" />
    <SolidColorBrush x:Key="B.Panel3" Color="{StaticResource C.Panel3}" />
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}" />
    <SolidColorBrush x:Key="B.Line2" Color="{StaticResource C.Line2}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.Text2" Color="{StaticResource C.Text2}" />
    <SolidColorBrush x:Key="B.Text3" Color="{StaticResource C.Text3}" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.Accent2" Color="{StaticResource C.Accent2}" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="{StaticResource C.AccentSoft}" />
    <SolidColorBrush x:Key="B.AccentLine" Color="{StaticResource C.AccentLine}" />
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="B.DangerSoft" Color="{StaticResource C.DangerSoft}" />
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="B.WarnSoft" Color="{StaticResource C.WarnSoft}" />
    <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="B.Pressed" Color="{StaticResource C.Pressed}" />
    <SolidColorBrush x:Key="B.ButtonBg" Color="{StaticResource C.ButtonBg}" />
    <SolidColorBrush x:Key="B.ButtonHover" Color="{StaticResource C.ButtonHover}" />
    <SolidColorBrush x:Key="B.ButtonPressed" Color="{StaticResource C.ButtonPressed}" />
    <SolidColorBrush x:Key="B.Select" Color="{StaticResource C.Select}" />
    <SolidColorBrush x:Key="B.Scrim" Color="{StaticResource C.Scrim}" />
    <SolidColorBrush x:Key="B.CheckerA" Color="{StaticResource C.CheckerA}" />
    <SolidColorBrush x:Key="B.CheckerB" Color="{StaticResource C.CheckerB}" />
    <SolidColorBrush x:Key="B.SliderTrack" Color="{StaticResource C.SliderTrack}" />
    <SolidColorBrush x:Key="B.InputBg" Color="{StaticResource C.InputBg}" />
    <SolidColorBrush x:Key="B.CropShade" Color="{StaticResource C.CropShade}" />
    <SolidColorBrush x:Key="B.ImageBorder" Color="{StaticResource C.ImageBorder}" />
    <SolidColorBrush x:Key="B.GridHalo" Color="{StaticResource C.GridHalo}" />
    <SolidColorBrush x:Key="B.GridCore" Color="{StaticResource C.GridCore}" />
    <SolidColorBrush x:Key="B.GridAccent" Color="{StaticResource C.GridAccent}" />
    <SolidColorBrush x:Key="B.LabelBg" Color="{StaticResource C.LabelBg}" />
    <SolidColorBrush x:Key="B.LabelBorder" Color="{StaticResource C.LabelBorder}" />
    <SolidColorBrush x:Key="B.LabelText" Color="{StaticResource C.LabelText}" />
    <SolidColorBrush x:Key="B.FrameHoverFill" Color="{StaticResource C.FrameHoverFill}" />
    <SolidColorBrush x:Key="B.FrameHoverLine" Color="{StaticResource C.FrameHoverLine}" />
    <SolidColorBrush x:Key="B.FrameSelFill" Color="{StaticResource C.FrameSelFill}" />
    <SolidColorBrush x:Key="B.FrameSelLine" Color="{StaticResource C.FrameSelLine}" />
    <SolidColorBrush x:Key="B.White" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="B.Black" Color="#FF000000" />
    <SolidColorBrush x:Key="B.Transparent" Color="#00000000" />
    <SolidColorBrush x:Key="B.PrimaryText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="B.TooltipBg" Color="#FF1C2230" />

    <!-- ============ 渐变 ============ -->
    <LinearGradientBrush x:Key="B.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8F9CFF" Offset="0" />
        <GradientStop Color="#FF6A7BFF" Offset="0.52" />
        <GradientStop Color="#FF49C2E6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.PrimaryHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9CA8FF" Offset="0" />
        <GradientStop Color="#FF7787FF" Offset="0.52" />
        <GradientStop Color="#FF5ECDF0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.Stage" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF141A29" Offset="0" />
        <GradientStop Color="#FF0A0C11" Offset="0.58" />
        <GradientStop Color="#FF080A0F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.SwitchOn" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8B97FF" Offset="0" />
        <GradientStop Color="#FF46E2CB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.LogoStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA7B2FF" Offset="0" />
        <GradientStop Color="#FF46E2CB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFE9EDF5" Offset="0" />
        <GradientStop Color="#FF8B97FF" Offset="1" />
    </LinearGradientBrush>

    <!-- 胶片条小棋盘 -->
    <DrawingBrush x:Key="B.CheckerSmall" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource B.CheckerA}" Geometry="M0,0 H12 V12 H0 Z" />
                <GeometryDrawing Brush="{StaticResource B.CheckerB}" Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 舞台柔光 -->
    <RadialGradientBrush x:Key="B.StageGlow" GradientOrigin="0.5,0.35" Center="0.5,0.35" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#148B97FF" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>

